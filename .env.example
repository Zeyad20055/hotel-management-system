# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Leave MONGODB_URI empty in DEVELOPMENT to use a temporary in-memory MongoDB
# (data is LOST when the server stops). Set it for persistent data:
#   MONGODB_URI=mongodb://127.0.0.1:27017/hotel_management
# Required when NODE_ENV=production.
MONGODB_URI=

# ---- Auth ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required (min 32 chars) when NODE_ENV=production.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- First administrator ----
# In production the first Super Admin is created from these values (both required).
# In development defaults to admin@hotel.local / Admin@12345 (must be changed at first login).
ADMIN_NAME=Hotel Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Optional ----
# Seed demo data when the dev database is empty (always on for in-memory mode)
SEED_DEMO=false
# Only needed if the frontend is served from a different origin than the API
CLIENT_ORIGIN=
# Vite dev server port
CLIENT_PORT=5173
